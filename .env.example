# Starlake Orchestration Test Environment
# Copy this file to .env and adjust values for your machine.
# These variables are loaded by conftest.py and can be overridden
# by system environment variables.

SL_VERSION=1.5.11
SL_ENV=DUCKDB
# Set JAVA_HOME to your Java 17 installation path (uncomment and adjust)
# JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
